{
  "name": "intuitui-web",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@12.3.1",
  "scripts": {
    "dev": "pnpm exec astro dev --host 127.0.0.1 --port 4321 --force",
    "dev:stop": "pnpm exec astro dev stop",
    "dev:status": "pnpm exec astro dev status",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "eslint .",
    "check-types": "pnpm exec tsc --build --noEmit",
    "test": "vitest run",
    "test:math": "vitest run --tagsFilter 'math'",
    "test:audit": "vitest run --tagsFilter 'dom'",
    "test:perf": "vitest run --detectAsyncLeaks --logHeapUsage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "doctor": "npx -y react-doctor@latest .",
    "doctor:design": "npx -y react-doctor@latest design"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.0",
    "@intuitui-labs/a11y-gate": "^0.2.0",
    "@intuitui-labs/editorial": "^0.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-win32-x64-msvc": "^1.2.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.4.1",
    "jsdom": "^30.0.1",
    "vercel": "^59.23.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
