---
import MainLayout from '../../layouts/MainLayout.astro';
import { publicProjects } from '../../lib/projects';

export function getStaticPaths() {
	return publicProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<MainLayout title={`${project.name} | Intuitui Labs`} theme="projects">
	<article class="max-w-4xl space-y-20 sm:space-y-28">
		<header class="space-y-8">
			<a class="text-sm font-mono underline decoration-black/20 underline-offset-4" href="/projects">← All work</a>
			<div class="space-y-5"><p class="mono-label">{project.statusLabel} · {project.category}</p><h1 class="text-5xl sm:text-7xl md:text-8xl font-bold tracking-tighter leading-[0.9]">{project.name}</h1><p class="max-w-2xl text-2xl text-brand-secondary font-light leading-snug">{project.relation}</p></div>
		</header>
		<section class="grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-8 md:gap-20 border-t border-black/10 pt-7" aria-labelledby="premise-heading"><h2 id="premise-heading" class="text-sm font-mono uppercase tracking-[0.16em]">The premise</h2><p class="text-xl text-brand-secondary leading-relaxed">{project.description}</p></section>
		<section class="bg-brand-primary text-white p-8 sm:p-12 md:p-16 space-y-6"><p class="mono-label text-white/60">A note on stage</p><h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">{project.statusLabel}</h2><p class="max-w-2xl text-white/70 leading-relaxed">{project.stageNote}</p></section>
		{project.links && <nav class="flex flex-wrap gap-x-7 gap-y-3 text-sm font-medium" aria-label={`${project.name} links`}>{project.links.map((link) => <a class="underline decoration-black/20 underline-offset-4 hover:decoration-brand-accent" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label} ↗</a>)}</nav>}
	</article>
</MainLayout>
