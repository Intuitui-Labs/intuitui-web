---
import MainLayout from '../../layouts/MainLayout.astro';
import { publicProjects } from '../../lib/projects';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';

export function getStaticPaths() {
	return publicProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;

const pillarLabel = {
	'developer-oss': 'Pillar 01 · Developer Ecosystem & OSS Program',
	'collaborative-products': 'Pillar 02 · Collaborative Products',
	'studio-initiatives': 'Pillar 03 · Autonomous Studio Initiatives',
}[project.pillar];
---

<MainLayout
	title={`${project.name} | Intuitui Labs`}
	theme="projects"
	publishedDate="2026-08-29T17:53:12+05:30"
	updatedDate="2026-10-11T18:00:00+05:30"
>
	<article class="max-w-4xl space-y-16 sm:space-y-24">
		<!-- Navigation & Header -->
		<header class="space-y-8">
			<a class="inline-flex items-center gap-2 text-sm font-mono font-semibold text-brand-secondary hover:text-brand-primary underline underline-offset-4 touch-target" href="/projects">
				<span aria-hidden="true">←</span>
				<span>Back to All Constellations</span>
			</a>
			
			<div class="space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-border bg-brand-surface w-fit">
						<span class="w-2 h-2 rounded-full bg-sky-600" aria-hidden="true"></span>
						<p class="mono-label">{project.statusLabel} · {project.category}</p>
					</div>
					{project.collaborationPartner && (
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono text-xs font-bold">
							<span>In Collaboration with {project.collaborationPartner}</span>
						</div>
					)}
				</div>

				<p class="font-mono text-xs font-bold uppercase tracking-wider text-slate-500">
					{pillarLabel}
				</p>

				<h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter leading-[0.92] text-brand-primary">
					{project.name}
				</h1>
				<p class="measure-optimal text-2xl text-brand-secondary font-normal leading-relaxed">
					{project.relation}
				</p>
			</div>
		</header>

		<!-- Developer & NPM Package Quick Actions (if applicable) -->
		{project.npmPackage && (
			<section class="p-6 rounded-2xl border-2 border-slate-900 bg-white space-y-4 shadow-sm" aria-label="Package installation and links">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="flex items-center gap-2 font-mono text-sm font-bold text-slate-900">
						<span class="px-2.5 py-1 rounded-md bg-sky-950 text-white text-xs">npm</span>
						<code>{project.npmPackage}</code>
					</div>
					<div class="flex items-center gap-3 font-mono text-xs font-bold">
						{project.docsHref && (
							<a
								href={project.docsHref}
								class="px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-700 text-white transition-colors shadow-2xs"
							>
								Read Documentation →
							</a>
						)}
						{project.githubRepo && (
							<a
								href={project.githubRepo}
								target="_blank"
								rel="noreferrer"
								class="px-3.5 py-2 rounded-lg border border-slate-300 hover:border-slate-900 text-slate-800 transition-colors"
							>
								GitHub ↗
							</a>
						)}
					</div>
				</div>

				{project.installSnippet && (
					<div class="bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-xs overflow-x-auto border border-slate-800">
						<code>{project.installSnippet}</code>
					</div>
				)}
			</section>
		)}

		<!-- The Premise -->
		<section class="grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-8 md:gap-16 border-t border-brand-border pt-8" aria-labelledby="premise-heading">
			<div class="space-y-1">
				<p class="mono-label">System Exploration</p>
				<h2 id="premise-heading" class="text-2xl font-bold text-brand-primary">The Premise</h2>
			</div>
			<p class="measure-optimal text-xl text-brand-secondary leading-relaxed">
				{project.description}
			</p>
		</section>

		<!-- Note on Stage (High-Contrast Obsidian Banner) -->
		<section class="rounded-3xl bg-brand-obsidian text-white p-8 sm:p-12 md:p-16 space-y-6 shadow-xl" aria-labelledby="stage-note-heading">
			<div class="flex items-center gap-2">
				<span class="w-2 h-2 rounded-full bg-sky-400" aria-hidden="true"></span>
				<p class="mono-label-inverse">A note on maturity</p>
			</div>
			<h2 id="stage-note-heading" class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
				{project.statusLabel}
			</h2>
			<p class="measure-optimal text-lg text-slate-200 leading-relaxed font-light">
				{project.stageNote}
			</p>
		</section>

		<!-- Links / Touch Targets -->
		{project.links && project.links.length > 0 && (
			<section class="pt-4 border-t border-brand-border" aria-label="Project external destinations">
				<h2 class="mono-label mb-4">External Destinations</h2>
				<nav class="flex flex-wrap gap-4">
					{project.links.map((link) => (
						<a
							class="touch-target px-6 py-3 rounded-xl bg-brand-primary text-white font-semibold text-sm hover:bg-slate-800 transition-colors flex items-center gap-2 shadow-sm"
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noreferrer' : undefined}
						>
							<span>{link.label}</span>
							<span aria-hidden="true">↗</span>
						</a>
					))}
				</nav>
			</section>
		)}
		
		<!-- Provenance & Editorial Colophon -->
		<ProvenanceColophon
			author="Intuitui Labs Systems Team"
			publishDate="2026-08-29T17:53:12+05:30"
			updatedDate="2026-10-11T18:00:00+05:30"
			cadence="living-document"
			canonicalUrl={`https://intuituilabs.studio/projects/${project.slug}`}
			version="v2.0"
			class="pt-8"
		/>
	</article>
</MainLayout>
