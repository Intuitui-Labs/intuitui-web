---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Intuitui Labs | Systems Intelligence" theme="home">
	<section class="space-y-24 sm:space-y-32">
		<header class="min-h-[calc(100svh-7rem)] flex flex-col justify-center max-w-4xl space-y-7 sm:space-y-9">
			<p class="mono-label">A philosophy-led systems studio · ;p</p>
			<h1 class="text-[3.75rem] sm:text-7xl md:text-8xl font-bold leading-[0.9] tracking-tighter">Making sense of <span class="text-brand-sky">complex life.</span></h1>
			<p class="max-w-2xl text-xl sm:text-2xl text-brand-secondary font-light leading-snug">Intuitui Labs explores how people, institutions, knowledge, and technology can form more humane systems — then gives those ideas practical shape.</p>
			<div class="flex flex-wrap gap-5 pt-2 text-sm font-medium">
				<a class="underline decoration-black/20 underline-offset-4 hover:decoration-brand-accent" href="/projects">See the work ↗</a>
				<a class="underline decoration-black/20 underline-offset-4 hover:decoration-brand-accent" href="/about">Read the philosophy ↗</a>
			</div>
			<p class="pt-6 text-xs font-mono text-brand-secondary/70">Brevity, Clarity, Levity. <span aria-hidden="true">⚡ · 💡 · 😜</span></p>
		</header>

		<section class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 border-t border-black/10 pt-8" aria-labelledby="practice-heading">
			<div class="md:col-span-1"><h2 id="practice-heading" class="text-sm font-mono uppercase tracking-[0.2em]">The practice</h2></div>
			<div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-8">
				<div class="space-y-3"><p class="text-2xl font-bold">See</p><p class="text-sm text-brand-secondary">Attend to reality before deciding what it means.</p></div>
				<div class="space-y-3"><p class="text-2xl font-bold">Make sense</p><p class="text-sm text-brand-secondary">Find patterns, relationships, and possibilities without flattening complexity.</p></div>
				<div class="space-y-3"><p class="text-2xl font-bold">Give form</p><p class="text-sm text-brand-secondary">Turn understanding into tools, platforms, experiments, and care.</p></div>
			</div>
		</section>

		<section class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-10 md:gap-24 items-start" aria-labelledby="gurudevi-heading">
			<div class="space-y-4"><p class="mono-label">First expression</p><h2 id="gurudevi-heading" class="text-4xl sm:text-5xl font-bold tracking-tight">Gurudevi</h2></div>
			<div class="space-y-6"><p class="text-xl text-brand-secondary leading-relaxed">An education ecology support system and sanctuary for teachers and learners, built as part of the EdLove constellation.</p><a class="text-sm font-medium underline decoration-black/20 underline-offset-4" href="https://gurudevi.edlove.org" target="_blank" rel="noreferrer">Visit Gurudevi ↗</a></div>
		</section>
	</section>
</MainLayout>
