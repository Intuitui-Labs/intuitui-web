---
import MainLayout from '../layouts/MainLayout.astro';
import { publicProjects } from '../lib/projects';

const featuredProject = publicProjects.find((project) => project.featured) ?? publicProjects[0];
const sensemakingProjects = publicProjects.filter((project) => project.status === 'sensemaking');
const seeingProjects = publicProjects.filter((project) => project.status === 'seeing');
---

<MainLayout title="Projects | Intuitui Labs" theme="projects">
	<div class="max-w-7xl mx-auto space-y-24 sm:space-y-32">
		<!-- Header -->
		<header class="max-w-4xl space-y-6">
			<div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border-2 border-slate-900 bg-white w-fit shadow-xs">
				<p class="font-mono text-sm font-bold text-slate-950 uppercase tracking-wider">Work in the constellation</p>
			</div>
			<h1 class="text-6xl sm:text-7xl md:text-8xl font-black tracking-tighter leading-[0.92] text-slate-950">
				Ideas made tangible.
			</h1>
			<p class="measure-optimal text-2xl text-slate-800 font-medium leading-relaxed">
				Intuitui Labs gives philosophy and sensemaking practical form — through systems, platforms, experiments, and living tools.
			</p>
		</header>

		<!-- Featured Showcase (Stage 04 Active) -->
		<section class="space-y-8" aria-labelledby="showcase-heading">
			<div class="flex items-end justify-between border-b-2 border-slate-900 pb-4">
				<div>
					<p class="mono-label mb-1">Featured Expression</p>
					<h2 id="showcase-heading" class="text-3xl sm:text-4xl font-black tracking-tight text-slate-950">
						Current Showcase
					</h2>
				</div>
				<span class="text-sm font-mono font-bold text-slate-700">
					{String(publicProjects.length).padStart(2, '0')} // REGISTERED
				</span>
			</div>

			{featuredProject && (
				<article class="systems-card overflow-hidden grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] bg-white" aria-labelledby="featured-project-title">
					<div class="min-h-80 md:min-h-[32rem] bg-slate-950 text-white relative overflow-hidden flex items-end p-8 md:p-12 border-b-2 md:border-b-0 md:border-r-2 border-slate-950">
						<div class="absolute inset-0 systems-grid opacity-25" aria-hidden="true"></div>
						<div class="absolute -right-20 -top-20 w-88 h-88 rounded-full border-2 border-sky-400/40" aria-hidden="true"></div>
						<div class="absolute right-1/4 top-1/3 w-4 h-4 rounded-full bg-sky-400" aria-hidden="true"></div>

						<div class="relative space-y-4">
							<span class="px-3.5 py-1.5 rounded-md bg-sky-900 text-sky-200 border-2 border-sky-400 font-mono text-xs font-black uppercase tracking-wider">
								{featuredProject.statusLabel}
							</span>
							<h3 id="featured-project-title" class="text-6xl sm:text-7xl font-black tracking-tighter text-white">
								{featuredProject.name}
							</h3>
						</div>
					</div>

					<div class="flex flex-col justify-between gap-8 p-8 md:p-12 bg-white">
						<div class="space-y-4">
							<p class="mono-label text-sky-800">{featuredProject.eyebrow}</p>
							<h4 class="text-3xl font-black tracking-tight text-slate-950">
								{featuredProject.relation}
							</h4>
							<p class="text-lg text-slate-800 font-medium leading-relaxed">
								{featuredProject.description}
							</p>
							<div class="pt-2">
								<span class="inline-block px-3.5 py-1.5 rounded-lg bg-slate-100 border border-slate-300 text-sm font-mono font-bold text-slate-950">
									{featuredProject.category}
								</span>
							</div>
						</div>

						{featuredProject.links && featuredProject.links.length > 0 && (
							<nav class="flex flex-wrap gap-4 pt-6 border-t-2 border-slate-200" aria-label={`${featuredProject.name} links`}>
								{featuredProject.links.map((link) => (
									<a
										class="touch-target tactile-press px-6 py-3 rounded-xl bg-slate-950 text-white font-bold text-base hover:bg-slate-800 transition-colors flex items-center gap-2 shadow-xs border-2 border-slate-950"
										href={link.href}
										target={link.external ? '_blank' : undefined}
										rel={link.external ? 'noreferrer' : undefined}
									>
										<span>{link.label}</span>
										<span aria-hidden="true">↗</span>
									</a>
								))}
							</nav>
						)}
					</div>
				</article>
			)}
		</section>

		<!-- Stage 02: Sensemaking -->
		{sensemakingProjects.length > 0 && (
			<section class="space-y-8" aria-labelledby="sensemaking-heading">
				<div class="flex items-end justify-between border-b-2 border-slate-900 pb-4">
					<div>
						<p class="mono-label mb-1">Maturity Phase</p>
						<h2 id="sensemaking-heading" class="text-3xl font-black tracking-tight text-slate-950">
							Stage 02 · Sensemaking
						</h2>
					</div>
					<span class="text-sm font-mono font-bold text-slate-700">
						{String(sensemakingProjects.length).padStart(2, '0')} // FORMING
					</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{sensemakingProjects.map((project) => (
						<article class="systems-card p-8 border-t-6 border-t-emerald-700 space-y-5 flex flex-col justify-between bg-white" aria-labelledby={`project-${project.slug}`}>
							<div class="space-y-4">
								<div class="flex items-center justify-between gap-4">
									<h3 id={`project-${project.slug}`} class="text-2xl sm:text-3xl font-black tracking-tight text-slate-950 hover:text-sky-700 transition-colors">
										<a href={`/projects/${project.slug}`}>{project.name}</a>
									</h3>
									<span class="px-3 py-1 rounded-md border border-emerald-700 bg-emerald-50 text-emerald-950 font-mono text-xs font-black uppercase">
										{project.statusLabel}
									</span>
								</div>
								<p class="text-base text-slate-800 font-medium leading-relaxed">
									{project.description}
								</p>
							</div>

							<div class="flex items-center justify-between pt-4 border-t border-slate-200">
								<span class="text-sm font-mono font-bold text-slate-600">
									{project.category}
								</span>
								<a href={`/projects/${project.slug}`} class="touch-target text-sm font-mono font-extrabold text-slate-950 hover:text-sky-700 underline underline-offset-4">
									View Details →
								</a>
							</div>
						</article>
					))}
				</div>
			</section>
		)}

		<!-- Stage 01: Seeing -->
		{seeingProjects.length > 0 && (
			<section class="space-y-8" aria-labelledby="seeing-heading">
				<div class="flex items-end justify-between border-b-2 border-slate-900 pb-4">
					<div>
						<p class="mono-label mb-1">Observation Phase</p>
						<h2 id="seeing-heading" class="text-3xl font-black tracking-tight text-slate-950">
							Stage 01 · Seeing
						</h2>
					</div>
					<span class="text-sm font-mono font-bold text-slate-700">
						{String(seeingProjects.length).padStart(2, '0')} // OBSERVING
					</span>
				</div>

				<div class="divide-y-2 divide-slate-200 border-y-2 border-slate-900">
					{seeingProjects.map((project) => (
						<article class="group grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-6 py-8 items-center" aria-labelledby={`project-seeing-${project.slug}`}>
							<div class="space-y-2">
								<div class="flex items-center gap-3">
									<h3 id={`project-seeing-${project.slug}`} class="text-2xl font-black tracking-tight text-slate-950 group-hover:text-sky-700 transition-colors">
										<a href={`/projects/${project.slug}`}>{project.name}</a>
									</h3>
									<span class="px-2.5 py-0.5 rounded-md border border-slate-400 bg-slate-100 text-slate-900 font-mono text-xs font-bold uppercase">
										{project.statusLabel}
									</span>
								</div>
								<p class="measure-optimal text-base text-slate-800 font-medium">
									{project.description}
								</p>
							</div>
							<div class="flex items-center gap-6">
								<span class="text-sm font-mono font-bold text-slate-600">
									{project.category}
								</span>
								<a href={`/projects/${project.slug}`} class="touch-target text-sm font-mono font-extrabold text-slate-950 hover:text-sky-700 underline underline-offset-4" aria-label={`Read notes on ${project.name}`}>
									Notes →
								</a>
							</div>
						</article>
					))}
				</div>
			</section>
		)}

		<!-- Discretionary Statement -->
		<div class="p-8 rounded-2xl border-2 border-slate-900 bg-white max-w-2xl shadow-xs space-y-2">
			<p class="mono-label text-slate-950">Studio Discretion</p>
			<p class="text-base text-slate-800 font-medium leading-relaxed">
				More work will appear here as it achieves public clarity. The constellation is deliberately curated: exploratory sensemaking remains internal until a grounded form is ready.
			</p>
		</div>
	</div>
</MainLayout>
