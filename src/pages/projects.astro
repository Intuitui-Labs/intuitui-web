---
import MainLayout from '../layouts/MainLayout.astro';
import { publicProjects } from '../lib/projects';

const featuredProject = publicProjects.find((project) => project.featured) ?? publicProjects[0];
const sensemakingProjects = publicProjects.filter((project) => project.status === 'sensemaking');
const seeingProjects = publicProjects.filter((project) => project.status === 'seeing');
---

<MainLayout title="Projects | Intuitui Labs" theme="projects">
	<div class="space-y-20">
		<header class="max-w-3xl space-y-6">
			<p class="mono-label">Work in the constellation</p>
			<h1 class="text-5xl md:text-7xl font-bold tracking-tighter leading-[0.95]">Ideas made tangible.</h1>
			<p class="text-xl text-brand-secondary leading-relaxed">
				Intuitui Labs gives philosophy and sensemaking a practical form — through products, platforms, experiments, and living systems.
			</p>
		</header>

		<section class="space-y-8" aria-labelledby="showcase-heading">
			<div class="flex items-end justify-between border-b border-black/5 pb-4">
				<h2 id="showcase-heading" class="text-sm font-mono uppercase tracking-[0.2em]">Current showcase</h2>
				<span class="text-[10px] opacity-30 font-mono">{String(publicProjects.length).padStart(2, '0')} // WORK</span>
			</div>

			{featuredProject && (
				<article class="group grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] gap-8 md:gap-16 border-b border-black/10 pb-12">
					<div class="min-h-72 md:min-h-[32rem] bg-brand-primary text-white relative overflow-hidden flex items-end p-7 md:p-12">
						<div class="absolute inset-0 systems-grid opacity-15"></div>
						<div class="absolute -right-24 -top-24 w-96 h-96 rounded-full border border-white/20 group-hover:scale-110 transition-transform duration-700"></div>
						<div class="absolute right-1/3 top-1/3 w-3 h-3 rounded-full bg-brand-sky group-hover:translate-x-8 transition-transform duration-500"></div>
						<div class="relative space-y-3"><p class="mono-label text-white opacity-60">{featuredProject.statusLabel}</p><p class="text-5xl md:text-7xl font-bold tracking-tighter">{featuredProject.name}</p></div>
					</div>
					<div class="flex flex-col justify-between gap-8 py-2">
						<div class="space-y-5"><p class="mono-label">{featuredProject.eyebrow}</p><h3 class="text-3xl md:text-4xl font-bold tracking-tight">{featuredProject.relation}</h3><p class="text-brand-secondary leading-relaxed">{featuredProject.description}</p><p class="text-xs font-mono text-brand-secondary/70">{featuredProject.category}</p></div>
						{featuredProject.links && <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium" aria-label={`${featuredProject.name} links`}>{featuredProject.links.map((link) => <a class="underline decoration-black/20 underline-offset-4 hover:decoration-brand-accent transition-colors" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label} ↗</a>)}</nav>}
					</div>
				</article>
			)}
		</section>

		{sensemakingProjects.length > 0 && <section class="space-y-8" aria-labelledby="sensemaking-heading"><div class="flex items-end justify-between border-b border-black/5 pb-4"><div><p class="mono-label mb-2">Stage 02</p><h2 id="sensemaking-heading" class="text-2xl font-bold tracking-tight">Sensemaking</h2></div><span class="text-[10px] opacity-30 font-mono">{String(sensemakingProjects.length).padStart(2, '0')} // FORMING</span></div><div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">{sensemakingProjects.map((project) => <article class="space-y-5 border-l-2 border-brand-leaf/60 pl-5 md:pl-7"><div class="flex items-center justify-between gap-4"><h3 class="text-2xl md:text-3xl font-bold tracking-tight">{project.name}</h3><span class="mono-label whitespace-nowrap">{project.statusLabel}</span></div><p class="text-sm text-brand-secondary leading-relaxed">{project.description}</p><p class="text-xs font-mono text-brand-secondary/70">{project.category}</p></article>)}</div></section>}

{seeingProjects.length > 0 && <section class="space-y-8" aria-labelledby="seeing-heading"><div class="flex items-end justify-between border-b border-black/5 pb-4"><div><p class="mono-label mb-2">Stage 01</p><h2 id="seeing-heading" class="text-2xl font-bold tracking-tight">Seeing</h2></div><span class="text-[10px] opacity-30 font-mono">{String(seeingProjects.length).padStart(2, '0')} // OBSERVING</span></div><div class="divide-y divide-black/10">{seeingProjects.map((project) => <article class="group grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3 sm:gap-6 py-6 first:pt-0"><div class="space-y-2"><h3 class="text-xl font-bold tracking-tight group-hover:text-brand-sky transition-colors"><a href={`/projects/${project.slug}`}>{project.name}</a></h3><p class="max-w-2xl text-sm text-brand-secondary">{project.description}</p></div><span class="self-start text-xs font-mono text-brand-secondary/60 sm:text-right">{project.category}</span></article>)}</div></section>}

		<p class="max-w-xl text-sm text-brand-secondary">More work will appear here as it becomes ready to share. The showcase is intentionally selective; not every Intuitui exploration is public.</p>
	</div>
</MainLayout>
