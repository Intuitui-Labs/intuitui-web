---
import MainLayout from '../../layouts/MainLayout.astro';
import { publicTeam } from '../../lib/team';
import ProfileIcon from '../../components/ProfileIcon.astro';
---

<MainLayout title="Our Team | Intuitui Labs" theme="about">
	<div class="max-w-5xl space-y-24 sm:space-y-32">
		<header class="max-w-3xl space-y-7"><a class="text-sm font-mono underline decoration-black/20 underline-offset-4" href="/about">← About Intuitui</a><div class="space-y-5"><p class="mono-label">The people behind the work · ;p</p><h1 class="text-5xl sm:text-7xl font-bold tracking-tighter leading-[0.92]">Our team.</h1><p class="text-2xl text-brand-secondary font-light leading-snug">A growing group of people who see differently, think carefully, and make useful things together.</p></div></header>
		<section class="space-y-8" aria-labelledby="team-heading"><div class="flex items-end justify-between border-b border-black/10 pb-4"><h2 id="team-heading" class="text-sm font-mono uppercase tracking-[0.16em]">People in the constellation</h2><span class="text-xs font-mono text-brand-secondary/60">{String(publicTeam.length).padStart(2, '0')} // PEOPLE</span></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">{publicTeam.map((member) => <article class="group space-y-5"><div class="aspect-[4/5] bg-brand-primary text-white relative overflow-hidden flex items-end p-6 sm:p-8">{member.image ? <img class="absolute inset-0 h-full w-full object-cover" src={member.image} alt={`${member.name}, ${member.role}`} /> : <><div class="absolute inset-0 systems-grid opacity-15"></div><div class="absolute -right-14 -top-14 h-48 w-48 rounded-full border border-brand-sky/40 group-hover:scale-110 transition-transform duration-700"></div><div class="relative text-7xl sm:text-8xl font-bold tracking-tighter">{member.initials}</div></>}</div><div class="space-y-3"><div class="flex items-start justify-between gap-4"><div><h3 class="text-2xl font-bold tracking-tight">{member.name}</h3><p class="text-xs font-mono text-brand-secondary mt-1">{member.role}</p>{member.handle && <p class="text-xs font-mono text-brand-secondary/60 mt-1">@{member.handle}</p>}</div>{member.links && <nav class="flex shrink-0 gap-2 pt-1" aria-label={`${member.name} profile links`}>{member.links.map((link) => <a class="flex h-8 w-8 items-center justify-center rounded-full border border-black/10 text-brand-secondary hover:border-brand-accent hover:text-brand-accent transition-colors" href={link.href} target="_blank" rel="noreferrer" aria-label={`${member.name} on ${link.label}`} title={link.label}><ProfileIcon icon={link.icon} /></a>)}</nav>}</div><p class="text-sm text-brand-secondary leading-relaxed">{member.brief}</p>{member.note && <p class="text-sm leading-relaxed">{member.note}</p>}</div></article>)}</div></section>
	</div>
</MainLayout>
