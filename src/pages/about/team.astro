---
import MainLayout from '../../layouts/MainLayout.astro';
import { publicTeam } from '../../lib/team';
import ProfileIcon from '../../components/ProfileIcon.astro';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';
---

<MainLayout title="Our Team | Intuitui Labs" theme="about" publishedDate="2026-08-29T17:53:12+05:30" updatedDate="2026-08-29T17:53:12+05:30">
	<div class="max-w-7xl mx-auto space-y-24 sm:space-y-32">
		<!-- Header -->
		<header class="max-w-4xl space-y-6">
			<a class="inline-flex items-center gap-2 text-base font-mono font-bold text-slate-900 hover:text-sky-700 underline underline-offset-4 touch-target" href="/about">
				<span aria-hidden="true">←</span>
				<span>About Intuitui</span>
			</a>
			<div class="space-y-4">
				<div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border-2 border-slate-900 bg-white w-fit shadow-xs">
					<p class="font-mono text-sm font-bold text-slate-950 uppercase tracking-wider">The people behind the work</p>
				</div>
				<h1 class="text-6xl sm:text-7xl md:text-8xl font-black tracking-tighter leading-[0.92] text-slate-950">
					Our Team.
				</h1>
				<p class="measure-optimal text-2xl text-slate-800 font-medium leading-relaxed">
					A growing group of people who see differently, think carefully, and make useful things together.
				</p>
			</div>
		</header>

		<!-- Team Members Grid -->
		<section class="space-y-8" aria-labelledby="team-heading">
			<div class="flex items-end justify-between border-b-2 border-slate-900 pb-4">
				<h2 id="team-heading" class="text-base font-mono font-black uppercase tracking-wider text-slate-950">
					People in the constellation
				</h2>
				<span class="text-sm font-mono font-bold text-slate-700">
					{String(publicTeam.length).padStart(2, '0')} // PEOPLE
				</span>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
				{publicTeam.map((member) => (
					<article class="systems-card p-7 space-y-6 flex flex-col justify-between bg-white" aria-labelledby={`member-name-${member.name.replace(/\s+/g, '-').toLowerCase()}`}>
						<div class="space-y-5">
							<div class="aspect-[4/5] rounded-xl bg-slate-950 text-white relative overflow-hidden flex items-end p-6 shadow-md border-2 border-slate-950">
								{member.image ? (
									<img
										class="absolute inset-0 h-full w-full object-cover"
										src={member.image}
										alt={`${member.name}, ${member.role}`}
										width="400"
										height="500"
										loading="lazy"
									/>
								) : (
									<>
										<div class="absolute inset-0 systems-grid opacity-25" aria-hidden="true"></div>
										<div class="absolute -right-10 -top-10 h-44 w-44 rounded-full border-2 border-sky-400/40" aria-hidden="true"></div>
										<div class="relative font-black font-mono text-7xl text-white tracking-tighter" aria-hidden="true">
											{member.initials}
										</div>
									</>
								)}
							</div>

							<div class="space-y-3">
								<div class="flex items-start justify-between gap-4">
									<div>
										<h3 id={`member-name-${member.name.replace(/\s+/g, '-').toLowerCase()}`} class="text-2xl sm:text-3xl font-black tracking-tight text-slate-950">
											{member.name}
										</h3>
										<p class="text-sm font-mono font-black text-sky-800 mt-1 uppercase tracking-wider">
											{member.role}
										</p>
										{member.handle && (
											<p class="text-sm font-mono font-bold text-slate-600 mt-0.5">
												@{member.handle}
											</p>
										)}
									</div>

									{member.links && member.links.length > 0 && (
										<nav class="flex shrink-0 gap-2 pt-1" aria-label={`${member.name} links`}>
											{member.links.map((link) => (
												<a
													class="touch-target h-10 w-10 rounded-full border-2 border-slate-900 bg-white text-slate-950 hover:bg-slate-950 hover:text-white transition-colors"
													href={link.href}
													target="_blank"
													rel="noreferrer"
													aria-label={`${member.name} on ${link.label}`}
													title={link.label}
												>
													<ProfileIcon icon={link.icon} />
												</a>
											))}
										</nav>
									)}
								</div>

								<p class="text-base text-slate-800 font-medium leading-relaxed pt-2 border-t border-slate-200">
									{member.brief}
								</p>

								{member.note && (
									<p class="text-sm text-slate-700 italic pt-1 font-medium">
										"{member.note}"
									</p>
								)}
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- Provenance & Editorial Colophon -->
		<ProvenanceColophon
			author="Intuitui Labs Constellation"
			publishDate="2026-08-29T17:53:12+05:30"
			updatedDate="2026-08-29T17:53:12+05:30"
			cadence="living-document"
			canonicalUrl="https://intuituilabs.edlove.org/about/team"
			version="v1.0"
			class="pt-8"
		/>
	</div>
</MainLayout>
