---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getAllDocs, type DocItem } from '../../lib/docs';

export function getStaticPaths() {
  const docs = getAllDocs();
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

interface Props {
  doc: DocItem;
}

const { doc } = Astro.props;
const { Content } = doc;
---

<DocsLayout currentDoc={doc}>
  <div class="prose max-w-none text-slate-900 leading-relaxed space-y-6 [&_h1]:text-4xl [&_h1]:font-black [&_h1]:tracking-tight [&_h1]:mb-6 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-slate-200 [&_h2]:pb-2 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-6 [&_h3]:mb-3 [&_p]:text-base [&_p]:text-slate-800 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_pre]:bg-slate-950 [&_pre]:text-slate-100 [&_pre]:p-4 [&_pre]:rounded-xl [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-slate-800 [&_pre]:my-4 [&_code]:font-mono [&_code]:text-sm [&_:not(pre)>code]:bg-slate-200/70 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded [&_:not(pre)>code]:text-slate-900 [&_blockquote]:border-l-4 [&_blockquote]:border-sky-600 [&_blockquote]:bg-sky-50/50 [&_blockquote]:p-4 [&_blockquote]:rounded-r-lg [&_blockquote]:italic [&_blockquote]:my-4 [&_table]:w-full [&_table]:border-collapse [&_table]:my-6 [&_th]:border [&_th]:border-slate-300 [&_th]:p-3 [&_th]:bg-slate-100 [&_th]:text-left [&_th]:font-mono [&_th]:text-xs [&_th]:uppercase [&_td]:border [&_td]:border-slate-300 [&_td]:p-3 [&_td]:text-sm [&_a]:text-sky-700 [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-sky-900">
    <Content />
  </div>
</DocsLayout>
