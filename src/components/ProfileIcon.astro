---
import type { ProfileIcon } from '../lib/team';

interface Props { icon: ProfileIcon; }
const { icon } = Astro.props;
---

{icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5V18M6.5 5.5v.01M11 18v-5a3 3 0 0 1 6 0v5M11 10v8" /></svg>}
{icon === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.3-4-2-5.5-2m11 4v-3.1a3.4 3.4 0 0 0-.9-2.6c3 0 6.1-1.5 6.1-6.5a5 5 0 0 0-1.3-3.5A4.7 4.7 0 0 0 17.3 3S16.2 2.6 14 4.1a13 13 0 0 0-4 0C7.8 2.6 6.7 3 6.7 3a4.7 4.7 0 0 0-1.1 1.3A5 5 0 0 0 4.3 7.8c0 5 3.1 6.5 6.1 6.5a3.4 3.4 0 0 0-.9 2.6V21" /></svg>}
{icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3.5" /><path d="M17.5 6.5h.01" /></svg>}
{icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 14 16M19 4 5 20" /></svg>}
{icon === 'email' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>}
{icon === 'website' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M3.8 12h16.4M12 3.5c2.2 2.4 3.2 5.2 3.2 8.5s-1 6.1-3.2 8.5c-2.2-2.4-3.2-5.2-3.2-8.5s1-6.1 3.2-8.5Z" /></svg>}

<style>
  svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
